[
  {
    "question": "2026年6月30日各国库的库存余额，从高到低前10名",
    "mql": {
      "table": "treasury_balance_journal",
      "columns": ["treasury_short_name", "balance"],
      "filter": [
        { "field": "stat_date", "op": "=", "value": "2026-06-30" }
      ],
      "orderBy": [
        { "field": "balance", "direction": "desc" }
      ],
      "limit": 10
    }
  },
  {
    "question": "2026年6月末各所属县的库存余额合计",
    "mql": {
      "table": "treasury_balance_journal",
      "filter": [
        { "field": "stat_date", "op": "=", "value": "2026-06-30" }
      ],
      "groupBy": ["county_treasury_name"],
      "metrics": [
        { "op": "sum", "field": "balance", "alias": "total_balance" }
      ],
      "orderBy": [
        { "field": "total_balance", "direction": "desc" }
      ]
    }
  },
  {
    "question": "2026年6月一般公共预算收入的本期金额和年累计金额",
    "mql": {
      "table": "treasury_income_detail",
      "filter": [
        { "field": "stat_date", "op": "=", "value": "202606" },
        { "field": "subject_code", "op": "=", "value": "T010101" }
      ],
      "metrics": [
        { "op": "sum", "field": "current_period_amount", "alias": "cur_amount" },
        { "op": "sum", "field": "year_to_date_amount", "alias": "ytd_amount" }
      ]
    }
  }
