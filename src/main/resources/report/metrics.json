  {
    "metricId": "deposit_balance",
    "name": "人民币定期存款账户余额",
    "unit": "CNY",
    "description": "人民币定期存款类账户余额合计，代表头寸中的定期占位部分",
    "category": "账户与头寸",
    "timeBound": false,
    "comparable": false,
    "valueColumn": "total_balance",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "account",
      "filter": [
        {
          "field": "account_type",
          "op": "=",
          "value": "DEPOSIT"
        },
        {
          "field": "status",
          "op": "=",
          "value": "ACTIVE"
        },
        {
