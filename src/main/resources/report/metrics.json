[
  {
    "metricId": "gk_eom_balance_total",
    "name": "全辖国库月末库存余额合计",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_balance",
    "nullPolicy": "BLOCK",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "filter": [
        {
          "field": "stat_date",
          "op": "=",
          "value": "{{period_end}}"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "balance",
          "alias": "total_balance"
        }
      ]
    }
  },
  {
    "metricId": "gk_eom_balance_city",
    "name": "市级库月末库存余额（苏州市中心支库本级）",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_balance",
    "nullPolicy": "BLOCK",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "filter": [
        {
          "field": "stat_date",
          "op": "=",
          "value": "{{period_end}}"
        },
        {
          "field": "treasury_code",
          "op": "=",
          "value": "1005000000"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "balance",
          "alias": "total_balance"
        }
      ]
    }
  },
  {
    "metricId": "gk_eom_balance_county_level",
    "name": "区县级库月末库存余额合计",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_balance",
    "nullPolicy": "BLOCK",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "joins": [
        {
          "table": "treasury_basic_info",
          "type": "inner",
          "on": [
            {
              "left": "treasury_balance_journal.treasury_code",
              "right": "treasury_basic_info.treasury_code"
            }
          ]
        }
      ],
      "filter": [
        {
          "field": "treasury_balance_journal.stat_date",
          "op": "=",
          "value": "{{period_end}}"
        },
        {
          "field": "treasury_basic_info.treasury_level",
          "op": "=",
          "value": 4
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "treasury_balance_journal.balance",
          "alias": "total_balance"
        }
      ]
    }
  },
  {
    "metricId": "gk_eom_balance_town_level",
    "name": "乡镇级库月末库存余额合计",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_balance",
    "nullPolicy": "BLOCK",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "joins": [
        {
          "table": "treasury_basic_info",
          "type": "inner",
          "on": [
            {
              "left": "treasury_balance_journal.treasury_code",
              "right": "treasury_basic_info.treasury_code"
            }
          ]
        }
      ],
      "filter": [
        {
          "field": "treasury_balance_journal.stat_date",
          "op": "=",
          "value": "{{period_end}}"
        },
        {
          "field": "treasury_basic_info.treasury_level",
          "op": "=",
          "value": 5
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "treasury_balance_journal.balance",
          "alias": "total_balance"
        }
      ]
    }
  },
  {
    "metricId": "gk_eom_active_treasury_count",
    "name": "月末在账国库数",
    "unit": "个",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "cnt",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "filter": [
        {
          "field": "stat_date",
          "op": "=",
          "value": "{{period_end}}"
        }
      ],
      "metrics": [
        {
          "op": "count",
          "field": "treasury_code",
          "distinct": true,
          "alias": "cnt"
        }
      ]
    }
  },
  {
    "metricId": "gk_month_debit_total",
    "name": "当月借方发生额合计",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_debit",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "filter": [
        {
          "field": "stat_date",
          "op": ">=",
          "value": "{{period_start}}"
        },
        {
          "field": "stat_date",
          "op": "<=",
          "value": "{{period_end}}"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "debit_amount",
          "alias": "total_debit"
        }
      ]
    }
  },
  {
    "metricId": "gk_month_credit_total",
    "name": "当月贷方发生额合计",
    "unit": "亿元",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_credit",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "filter": [
        {
          "field": "stat_date",
          "op": ">=",
          "value": "{{period_start}}"
        },
        {
          "field": "stat_date",
          "op": "<=",
          "value": "{{period_end}}"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "credit_amount",
          "alias": "total_credit"
        }
      ]
    }
  },
  {
    "metricId": "gk_eom_balance_by_county",
    "name": "月末库存余额按所属县拆解（不含市库本级，余额降序）",
    "unit": "亿元",
    "timeBound": true,
    "comparable": false,
    "valueColumn": "total_balance",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "dimensions": [
      "county_treasury_name"
    ],
    "mqlTemplate": {
      "table": "treasury_balance_journal",
      "joins": [
        {
          "table": "treasury_basic_info",
          "type": "inner",
          "on": [
            {
              "left": "treasury_balance_journal.treasury_code",
              "right": "treasury_basic_info.treasury_code"
            }
          ]
        }
      ],
      "filter": [
        {
          "field": "treasury_balance_journal.stat_date",
          "op": "=",
          "value": "{{period_end}}"
        },
        {
          "field": "treasury_basic_info.treasury_level",
          "op": "!=",
          "value": 3
        }
      ],
      "groupBy": [
        "treasury_balance_journal.county_treasury_name"
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "treasury_balance_journal.balance",
          "alias": "total_balance"
        }
      ],
      "orderBy": [
        {
          "field": "total_balance",
          "direction": "desc"
        }
      ]
    }
  }
]