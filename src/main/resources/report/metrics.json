[
  {
    "metricId": "cny_total_balance",
    "name": "人民币活跃账户余额合计",
    "unit": "CNY",
    "description": "全部 ACTIVE 状态人民币账户的当前余额加总，快照口径不含冻结/销户账户",
    "category": "账户与头寸",
    "timeBound": false,
    "comparable": false,
    "valueColumn": "total_balance",
    "nullPolicy": "BLOCK",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "account",
      "filter": [
        {
          "field": "currency",
          "op": "=",
          "value": "CNY"
        },
        {
          "field": "status",
          "op": "=",
          "value": "ACTIVE"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "field": "balance",
          "alias": "total_balance"
        }
      ]
    }
  },
