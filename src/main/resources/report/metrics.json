  {
    "metricId": "week_txn_count",
    "name": "本期交易笔数（不含失败）",
    "unit": "笔",
    "description": "报告期内状态非 FAILED 的交易笔数，衡量交易活跃度",
    "category": "交易与收支",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "cnt",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "mqlTemplate": {
      "table": "cash_transaction",
      "filter": [
        {
          "field": "txn_date",
          "op": ">=",
          "value": "{{period_start}}"
        },
        {
          "field": "txn_date",
          "op": "<=",
          "value": "{{period_end}}"
        },
        {
          "field": "status",
          "op": "!=",
          "value": "FAILED"
        }
      ],
      "metrics": [
        {
          "op": "count",
          "alias": "cnt"
        }
      ]
    }
  },
  {
    "metricId": "week_txn_amount_cny",
    "name": "本期交易总额（折人民币）",
    "unit": "CNY",
    "description": "报告期内全部成功交易金额按汇率折人民币加总",
    "category": "交易与收支",
    "timeBound": true,
    "comparable": true,
    "valueColumn": "total_cny",
    "nullPolicy": "ZERO",
    "qualityChecks": [
      "NON_NEGATIVE"
    ],
    "anomalyRules": [
      {
        "type": "volatility",
        "basis": "wow",
        "absPct": 30,
        "dimensionMetricId": "week_txn_amount_by_currency"
      },
      {
        "type": "volatility",
        "basis": "mom",
        "absPct": 30,
        "dimensionMetricId": "week_txn_amount_by_currency"
      },
      {
        "type": "volatility",
        "basis": "yoy",
        "absPct": 50
      }
    ],
    "mqlTemplate": {
      "table": "cash_transaction",
      "joins": [
        {
          "table": "currency_rate",
          "type": "inner",
          "on": [
            {
              "left": "cash_transaction.currency",
              "right": "currency_rate.currency"
            }
          ]
        }
      ],
      "filter": [
        {
          "field": "currency_rate.rate_date",
          "op": "=",
          "subquery": {
            "table": "currency_rate",
            "metrics": [
              {
                "op": "max",
                "field": "rate_date",
                "alias": "latest"
              }
            ]
          }
        },
        {
          "field": "cash_transaction.txn_date",
          "op": ">=",
          "value": "{{period_start}}"
        },
        {
          "field": "cash_transaction.txn_date",
          "op": "<=",
          "value": "{{period_end}}"
        },
        {
          "field": "cash_transaction.status",
          "op": "!=",
          "value": "FAILED"
        }
      ],
      "metrics": [
        {
          "op": "sum",
          "fieldExpr": {
            "left": "cash_transaction.amount",
            "arith": "*",
            "right": "currency_rate.rate_to_cny"
          },
          "alias": "total_cny"
        }
      ]
    }
  },
